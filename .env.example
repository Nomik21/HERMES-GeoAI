# Copy this file to .env and fill in real values. Never commit .env.

# Required. OpenAI API key used by the GeoPerception Agent (GPA) via the
# OpenAI Responses API (model gpt-4.1-mini, hardcoded in geo_perception.py).
OPENAI_API_KEY=

# Required. Google Gemini API key used by:
#   - GeoImageRestoration Agent (GIRA) -- optional planner mode only
#   - GeoDamageAnalysis Agent (GDAA)
#   - GeoReasoning Agent (GRA)
GEMINI_API_KEY=

# Optional. Gemini model used by GIRA's restoration-tool planner (planner
# mode only -- it selects which deterministic restoration tool to apply,
# it never edits pixels itself). Also used as a fallback default for
# GEMINI_DAMAGE_MODEL below if that is left unset.
GEMINI_PLANNER_MODEL=gemini-2.5-flash

# Optional. Gemini model used by GDAA for severity / damage-scenario analysis.
# Falls back to GEMINI_PLANNER_MODEL, then to "gemini-2.5-flash", if unset.
GEMINI_DAMAGE_MODEL=gemini-2.5-flash

# Optional. Gemini model used by GDAA's zero-shot object-detection scenario.
# Falls back to GEMINI_DAMAGE_MODEL if unset.
GEMINI_DETECTION_MODEL=gemini-2.5-flash

# Optional. Gemini model used by GRA for the optional guarded narrative pass.
# Defaults to "gemini-2.5-flash" if unset.
GEMINI_REASONING_MODEL=gemini-2.5-flash
